    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>37b557ad-0145-432d-bc58-847e3bd1828a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
