# Copy this file to .env and replace every password before starting the stack.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
FOODDELIVERY_DB_PASSWORD=replace-with-a-long-random-app-db-password

KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-keycloak-db-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_PORT=8080

PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=replace-with-a-long-random-password
PGADMIN_PORT=5050

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_PORT=6379

KAFKA_PORT=9094
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_PORT=3000
